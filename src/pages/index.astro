---
import SiteLayout from '../layouts/site/SiteLayout.astro';
import { features } from '../data/site/nav.js';
---
<SiteLayout>
  <section class="landing-intro">
    <h1>raven.click</h1>
    <p>Recipes, training, and whatever comes next.</p>
  </section>
  <div class="feature-cards">
    {features.map(feature => (
      <a href={feature.href} class="feature-card">
        <h2>{feature.name}</h2>
        <p>{feature.blurb}</p>
      </a>
    ))}
  </div>
</SiteLayout>
